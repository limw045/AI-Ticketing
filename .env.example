NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Bootstrap supabase/schema first; legacy installations can explicitly use public.
NEXT_PUBLIC_SUPABASE_SCHEMA=gtjbticketing
NEXT_PUBLIC_TICKET_ATTACHMENT_BUCKET=gtjbticketing-attachments
# Development can share production Auth while retaining its own data project.
# Leave both unset when Auth and data belong to the same project.
NEXT_PUBLIC_SUPABASE_AUTH_URL=
NEXT_PUBLIC_SUPABASE_AUTH_ANON_KEY=
# Server-only development JWT secret, required only for separate Auth/data projects.
# Save in .env.local; never prefix with NEXT_PUBLIC_ or commit the value.
SUPABASE_DATA_JWT_SECRET=
